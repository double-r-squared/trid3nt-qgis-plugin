{
  "mcpServers": {
    "trid3nt": {
      "command": "/absolute/path/to/trid3nt-local/venvs/agent/bin/python",
      "args": ["-m", "trid3nt_server.mcp_server"],
      "cwd": "/absolute/path/to/trid3nt-local",
      "env": {
        "AWS_ENDPOINT_URL": "http://localhost:9000",
        "AWS_ACCESS_KEY_ID": "minioadmin",
        "AWS_SECRET_ACCESS_KEY": "minioadmin",
        "AWS_REGION": "us-east-1",
        "TRID3NT_CACHE_BUCKET": "trid3nt-cache",
        "TRID3NT_RUNS_BUCKET": "trid3nt-runs",
        "TRID3NT_RUNS_DIR": "/absolute/path/to/trid3nt-local/run",
        "TRID3NT_INPUT_GATE_MODE": "auto"
      }
    }
  }
}
