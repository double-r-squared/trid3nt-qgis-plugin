__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
.env
*.log
bin/
third_party/
venvs/
/data/
logs/
# run/ carries the daemon's local state AND run/proof - the transient packet
# tree the renderer sweeps to a seven-day TTL. A packet is a delivery, not an
# archive, so git never holds one.
run/
runs/
cache/
server/build/

# Secret-bearing local env (OpenRouter/API keys) - never commit
.env.local
.env.*.local
# Nutshell — local server state and API key
.nutshell-api-key
.nutshell-server.pid
.nutshell-server.log
.env.local.bak
*.egg-info/
.vscode/
dist/
.restructure-baseline/
.structural-baseline/

# oceanmesh sandbox bulk data (re-downloadable DEMs + GSHHG shoreline)
scripts/sandbox/oceanmesh/_runs/
scripts/sandbox/oceanmesh/shoreline/
# pysheds watershed sandbox bulk data (re-downloadable 3DEP DEMs)
scripts/sandbox/pysheds_watershed/_work/
# hecras rain-on-grid reference decks (re-downloadable USACE example projects)
scripts/sandbox/hecras/_ref/

# Machine-shaped harnesses: local-model benches, one-shot store migrations and
# direct-call bench conveniences. Git does not protect these - they live only on
# the machine that runs them, and a fresh clone has neither the ollama, the
# object store nor the runs they read.
scripts/local/

# Staged-dataset working directories (scripts/staging/*.py --work-dir default).
# Multi-GB downloads, extracted source rasters and intermediate mosaics; the
# staging scripts rebuild them and the product lives in the object store.
# Narrow on purpose -- scratchpad/ itself carries tracked proof artifacts.
scratchpad/staging/
scratchpad/
experiments/

# machine-only: regenerated wholesale by scripts/instruments/code_graph.py on every run
docs/validation/code-graph/graph.json

# the rulings record stays local; git holds the code, not the decisions
docs/IDEAS.md

# the local model build recipe is machine setup, not product
ollama/
