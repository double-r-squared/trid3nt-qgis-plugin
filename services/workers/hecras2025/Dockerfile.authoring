# HEC-RAS 2D AUTHORING worker (OI-B) -- the fresh-AOI mesh + subgrid-table stage.
#
# Built FROM the ADR 0129 substitution image (`hecras2025:subst-exp`): the HEC-RAS
# 2025 managed .NET CLI + the SUBSTITUTED open-source GDAL 3.11.5 / HDF5 / SQLite
# natives, on which `ras createterrain` + `MeshPropertyTables.ComputeFrom` run
# HEADLESS on Linux (RECIPE_SUMMARY.txt / ADR 0129). This layer bakes the compiled
# `AuthorMesh` (the OI-B link-c1 dumper, ADR 0134/0139) beside the app so the
# authoring STAGE is a one-command entrypoint.
#
# THE AUTHORING STAGE (this image):
#   terrain.tif (+ nvalue.tif) + perimeter_ccw_open.f64 + centers.f64
#     -> ras createterrain            (DEM -> HEC terrain .hdf; ADR 0129)
#     -> AuthorMesh  (TryCreateMesh topology + ComputeFrom subgrid tables)
#     -> dump: faces/facepoints/cellcenters/cell-face lists/normals/perimeter
#              + cell/face subgrid tables (the hecras_geometry_writer Mesh2D inputs)
# THE DECK + SOLVE STAGE (separate, the existing `trid3nt-local/hecras:latest`):
#   the host/orchestrator runs `authormesh_to_mesh2d` -> `compose_pure2d_deck`
#   -> RasGeomPreprocess + RasUnsteady (ADR 0136/0138). Two images because the
#   authoring natives (substituted GDAL) and the production 6.6 solver engines are
#   distinct payloads; the deck composer + adapter are pure numpy/h5py (host or a
#   thin python layer), so they are NOT baked here (kept image minimal).
#
# CONTAINER HYGIENE: the base is 1.85 GB (0.54 GB compressed) -- the .NET runtime +
# the managed HEC assemblies + the conda GDAL 3.11.5/HDF5 stack (ADR 0129). This
# layer ADDS only the ~13 KB `authormesh.dll` + its runtimeconfig + the entrypoint
# (< 1 MB). No new native payload, no python. `docker history` shows one thin layer.
#
# BUILD (AuthorMesh compiled against the beta DLLs in the SDK image first -- see
# subst/crux/transplant/AuthorMesh.csproj + REPRODUCE_TRANSPLANT.txt):
#   docker build -f Dockerfile.authoring \
#     --build-arg AUTHORMESH_DIR=subst/crux/transplant/out_authormesh \
#     -t trid3nt-local/hecras2025-authoring:latest .
#
# PROVENANCE: HEC-RAS is public-domain U.S. Federal Government software (USACE HEC).
# The 2025 beta is NOT for production studies; this worker authors GEOMETRY, which
# the production 6.6 engines then solve (transplant-path validated end-to-end,
# ADR 0132/0139).

FROM hecras2025:subst-exp

ARG AUTHORMESH_DIR=subst/crux/transplant/out_authormesh

# Bake the compiled AuthorMesh beside the app; reuse the app runtimeconfig so the
# sibling assemblies + the substituted native GDAL/HDF5 resolve (the same shim the
# ADR 0132 harnesses use).
COPY ${AUTHORMESH_DIR}/authormesh.dll /opt/hecras2025/app/authormesh.dll
RUN cp /opt/hecras2025/app/ras.runtimeconfig.json \
       /opt/hecras2025/app/authormesh.runtimeconfig.json
COPY authoring_entrypoint.sh /opt/hecras2025/authoring_entrypoint.sh
RUN chmod +x /opt/hecras2025/authoring_entrypoint.sh

LABEL org.opencontainers.image.title="trid3nt-hecras2025-authoring" \
      org.opencontainers.image.description="HEC-RAS 2D fresh-AOI mesh + subgrid-table authoring worker (OI-B, ADR 0139): ras createterrain + AuthorMesh (TryCreateMesh topology + MeshPropertyTables.ComputeFrom) on the ADR 0129 substituted Linux natives. Authors geometry the production 6.6 engines solve. HEC-RAS is public-domain U.S. Federal Government software (USACE HEC). BETA -- not for production studies." \
      org.opencontainers.image.licenses="Public-Domain-US-Gov"

WORKDIR /work
ENTRYPOINT ["/opt/hecras2025/authoring_entrypoint.sh"]
CMD []
