# HEC-RAS 2025 substitution experiment v2 (ADR 0129): GDAL 3.11.5 (conda-forge) +
# SHIMMED SWIG wraps (OpenShared/Open overload aliases) to match HEC's customized
# GDAL C# binding, so createterrain's GetProjection resolves. Peels the onion:
# reveals whether the meshing path needs deeper HEC-custom entrypoints or completes.
FROM trid3nt-local/hecras2025:probe

# conda-forge GDAL 3.11 stack (libgdal + gdal-data + proj + hdf5 + tools)
RUN set -e; apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl bzip2 ca-certificates && rm -rf /var/lib/apt/lists/*; \
    curl -fsSL https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C /usr/local bin/micromamba; \
    /usr/local/bin/micromamba create -y -p /opt/g -c conda-forge "gdal=3.11" hdf5 >/tmp/mm.log 2>&1 || { tail -20 /tmp/mm.log; exit 1; }; \
    ARCH=/opt/g/lib; \
    H5=$(ls $ARCH/libhdf5.so* 2>/dev/null | head -1); [ -e "$ARCH/libhdf5.so" ] || ln -sf "$H5" $ARCH/libhdf5.so; \
    H5HL=$(ls $ARCH/libhdf5_hl.so* 2>/dev/null | head -1); [ -e "$ARCH/libhdf5_hl.so" ] || ln -sf "$H5HL" $ARCH/libhdf5_hl.so; \
    echo "conda gdal $(/opt/g/bin/gdal-config --version)"

ENV LD_LIBRARY_PATH=/opt/g/lib RAS_GDAL=/opt/gdalroot
RUN set -e; mkdir -p $RAS_GDAL/common/data $RAS_GDAL/bin $RAS_GDAL/lib; \
    cp -a /opt/g/share/gdal/. $RAS_GDAL/common/data/ 2>/dev/null || true; \
    cp -a /opt/g/share/proj/.  $RAS_GDAL/common/data/ 2>/dev/null || true; \
    for t in gdalwarp gdal_translate gdalbuildvrt gdalinfo gdaladdo gdaldem gdal_contour gdal_rasterize ogr2ogr ogrinfo; do \
      [ -x /opt/g/bin/$t ] && ln -sf /opt/g/bin/$t $RAS_GDAL/bin/$t; done
COPY build3/libgdal_wrap.so build3/libgdalconst_wrap.so build3/libogr_wrap.so build3/libosr_wrap.so $RAS_GDAL/lib/
COPY assets/libe_sqlite3.so /opt/hecras2025/app/libe_sqlite3.so
COPY assets/tiny_dem.tif /data/tiny_dem.tif
ENTRYPOINT ["/bin/sh","-c"]
CMD ["dotnet /opt/hecras2025/app/ras.dll healthcheck"]
