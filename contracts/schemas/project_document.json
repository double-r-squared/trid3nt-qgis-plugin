{
  "$defs": {
    "LegendKey": {
      "additionalProperties": false,
      "description": "A layer's RESOLVED style: what the reader is looking at, and its scale.\n\nA preset is four renderer shapes parameterised by what the data is; this is\none of them resolved against a particular layer. The colours and the range\nare the SAME ones the render uses, because both come from this one\nresolution - there is no second range to drift.\n\n``qml`` is the resolved preset as QGIS's own style document, which is what\nthe map loads - the ONE record of how the layer is painted, swatches and\nclass breaks included. ``None`` for a layer that is already painted (an\nRGB(A) composite, a COG carrying its own colour table): nothing may\noverride the colours such a file already has.\n\nThe remaining fields are what a reader other than the map asks of a\npublished layer: the scale a packet holds a quantity to, and the words a\nrestyle starts from.\n\n``kind``\n    Which preset shape drew it: ``continuous`` (a ramp over a range),\n    ``classed`` (declared breaks or an embedded class table),\n    ``reference`` (drawn, not measured), ``mesh`` (an MDAL dataset group).\n``colormap``\n    The ramp name, or explicit stops as ``[[stop_0to1, \"#rrggbb\"], ...]``.\n``vmin`` / ``vmax``\n    The one range the layer is read on. ``None`` for a reference layer.\n``units`` / ``label``\n    What the quantity is measured in and what the legend calls it.",
      "properties": {
        "colormap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colormap"
        },
        "kind": {
          "enum": [
            "continuous",
            "classed",
            "reference",
            "mesh"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "qml": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qml"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "vmax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmax"
        },
        "vmin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmin"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LegendKey",
      "type": "object"
    },
    "ProjectLayerSummary": {
      "additionalProperties": false,
      "description": "Denormalized layer entry on a project (and on session map state).\n\nOne store, one scheme: ``uri`` is the layer's ONE reference\n(``s3://bucket/key``), which the client reads natively. ``opacity``\n(0.0-1.0) and ``z_index`` enable layer-stack arbitration; clients fall back\nto ``1.0`` / a default order if both are absent.\n\n``legend`` is the layer's RESOLVED style, mirrored from ``LayerURI.legend``\n(see ``execution.LegendKey``): the concrete range, the colours and the .qml\nthe map loads. The pipeline emitter copies it onto this summary.",
      "properties": {
        "crs_authid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crs Authid"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "layer_type": {
          "enum": [
            "raster",
            "vector",
            "mesh"
          ],
          "title": "Layer Type",
          "type": "string"
        },
        "legend": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegendKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "opacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opacity"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "reference_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Time"
        },
        "role": {
          "enum": [
            "primary",
            "context",
            "input"
          ],
          "title": "Role",
          "type": "string"
        },
        "temporal": {
          "title": "Temporal",
          "type": "boolean"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "visible": {
          "title": "Visible",
          "type": "boolean"
        },
        "z_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Z Index"
        }
      },
      "required": [
        "layer_id",
        "name",
        "layer_type",
        "uri",
        "visible",
        "role",
        "temporal"
      ],
      "title": "ProjectLayerSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``projects`` (D.2): metadata index over .qgs files in GCS.",
  "properties": {
    "_id": {
      "title": "Id",
      "type": "string"
    },
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deleted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deleted At"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "hazard_types": {
      "items": {
        "type": "string"
      },
      "title": "Hazard Types",
      "type": "array"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/ProjectLayerSummary"
      },
      "title": "Layers",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "qgs_uri": {
      "title": "Qgs Uri",
      "type": "string"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "_id",
    "session_id",
    "qgs_uri",
    "name",
    "created_at",
    "updated_at"
  ],
  "title": "ProjectDocument",
  "type": "object"
}
