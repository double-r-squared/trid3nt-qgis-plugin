{
  "additionalProperties": false,
  "description": "``spatial-input-response``: the user picked a geometry, or cancelled.\nThree shapes on one payload: a point or bbox sets ``coordinates``, a draw\nsets a role-tagged ``features``, a cancellation sets neither.",
  "properties": {
    "cancelled": {
      "default": false,
      "title": "Cancelled",
      "type": "boolean"
    },
    "coordinates": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coordinates"
    },
    "features": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Features"
    },
    "geometry_type": {
      "anyOf": [
        {
          "enum": [
            "point",
            "bbox",
            "vector_draw"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geometry Type"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "request_id"
  ],
  "title": "SpatialInputResponsePayload",
  "type": "object"
}
