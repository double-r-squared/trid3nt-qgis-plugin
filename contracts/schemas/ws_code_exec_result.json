{
  "additionalProperties": false,
  "description": "``code-exec-result``, emitted AFTER the sandbox returns.\n``status`` is the HONEST terminal outcome - a blocked or timed-out run is\nnever dressed up as ``ok`` - and narrated numbers come from ``result``.",
  "properties": {
    "code_exec_id": {
      "title": "Code Exec Id",
      "type": "string"
    },
    "duration_s": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Duration S",
      "type": "number"
    },
    "envelope_type": {
      "const": "code-exec-result",
      "default": "code-exec-result",
      "title": "Envelope Type",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "timeout",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "stderr_tail": {
      "default": "",
      "maxLength": 16384,
      "title": "Stderr Tail",
      "type": "string"
    },
    "stdout_tail": {
      "default": "",
      "maxLength": 16384,
      "title": "Stdout Tail",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "code_exec_id",
    "status"
  ],
  "title": "CodeExecResultPayload",
  "type": "object"
}
