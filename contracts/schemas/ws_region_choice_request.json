{
  "$defs": {
    "RegionCandidate": {
      "additionalProperties": false,
      "description": "A single selectable sub-region of the snapped state.\nOne per administrative feature within the detected state.",
      "properties": {
        "admin_level": {
          "const": "county",
          "default": "county",
          "title": "Admin Level",
          "type": "string"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "region_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        }
      },
      "required": [
        "region_id",
        "name",
        "bbox"
      ],
      "title": "RegionCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``region-choice-request``: server -> client, narrow the snapped region.\nThe turn PAUSES on this and FAILS OPEN - on timeout or with no interactive\nclient the whole-state bbox, already resolved, is used unchanged.",
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/RegionCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "default_action": {
      "const": "use_whole_state",
      "default": "use_whole_state",
      "title": "Default Action",
      "type": "string"
    },
    "envelope_type": {
      "const": "region-choice-request",
      "default": "region-choice-request",
      "title": "Envelope Type",
      "type": "string"
    },
    "message": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "state_bbox": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "State Bbox",
      "type": "array"
    },
    "state_code": {
      "maxLength": 2,
      "minLength": 1,
      "title": "State Code",
      "type": "string"
    },
    "state_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "State Name",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "state_name",
    "state_code",
    "state_bbox",
    "message"
  ],
  "title": "RegionChoiceRequestEnvelopePayload",
  "type": "object"
}
