{
  "$defs": {
    "ToolCandidate": {
      "additionalProperties": false,
      "description": "One ranked tool candidate inside a ``tool-candidates`` request.",
      "properties": {
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "summary": {
          "default": "",
          "maxLength": 500,
          "title": "Summary",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name"
      ],
      "title": "ToolCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``tool-candidates``: agent -> client, the tool picker.",
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/ToolCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "reason": {
      "enum": [
        "ambiguity",
        "ask_mode"
      ],
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "stage_label": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Stage Label",
      "type": "string"
    },
    "timeout_s": {
      "default": 60.0,
      "exclusiveMinimum": 0,
      "title": "Timeout S",
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "stage_label",
    "reason"
  ],
  "title": "ToolCandidatesPayload",
  "type": "object"
}
