      "type": "object"
    },
    "PipelineSnapshot": {
      "additionalProperties": false,
      "description": "A persisted pipeline run.",
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "final_state": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final State"
        },
        "pipeline_id": {
          "title": "Pipeline Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PipelineStepSummary"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "pipeline_id",
        "started_at"
      ],
      "title": "PipelineSnapshot",
      "type": "object"
    },
    "PipelineStepSummary": {
      "additionalProperties": false,
      "description": "A step in a persisted pipeline snapshot. ``cancelled`` is distinct.\n\nOptional progress + error fields (sprint-06 M4 pre-flight,\nresolving OQ-W-26-PIPELINE-STEP-FIELDS):\n\n- ``progress_percent`` is an integer 0..100, populated by the workflow\n  when it can reasonably attribute progress (e.g. solver chunk N of M,\n  n-of-M rows processed). Optional everywhere \u2014 never an LLM estimate\n  (Invariant 1: determinism boundary).\n- ``error_code`` is a ``SCREAMING_SNAKE_CASE`` literal aligned with the\n  error-code convention; populated only when ``state ==\n  \"failed\"``. The set of valid codes is **open** per A.6 (every workflow\n  may register its own); validation is shape-only (regex).\n- ``error_message`` is a short human-readable accompanier, capped at\n  512 chars to discourage stack-trace leakage. Free text.\n- ``duration_ms`` (ELEVATED tool-timer requirement) is the\n  authoritative wall-clock elapsed time, derived deterministically from\n  ``completed_at - started_at`` and stamped on the **terminal** transition\n  (complete / failed / cancelled) by the ``PipelineEmitter``. Never an LLM\n  estimate (Invariant 1). Optional / ``None`` for pending/running. ``ge=0``.\n\nTightening these to required on ``state == \"running\"`` / ``state ==\n\"failed\"`` is a deliberate follow-up \u2014 see report Open Questions.\nNo cost field anywhere (Invariant 9).",
      "properties": {
        "batch_job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Job Id"
        },
        "batch_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Status"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_message": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Step Id"
        },
        "progress_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress Percent"
        },
        "role": {
          "default": "tool",
          "enum": [
            "tool",
            "compute"
          ],
          "title": "Role",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "state": {
          "enum": [
            "pending",
            "running",
            "complete",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "substep_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substep Index"
        },
        "substep_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substep Label"
        },
        "substep_total": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substep Total"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "name",
        "tool_name",
        "state"
      ],
      "title": "PipelineStepSummary",
      "type": "object"
    },
    "ProjectLayerSummary": {
      "additionalProperties": false,
      "description": "Denormalized layer entry on a project (and on session map state).\n\nOne store, one scheme: ``uri`` is the layer's ONE reference\n(``s3://bucket/key``), which the client reads natively. ``opacity``\n(0.0-1.0) and ``z_index`` enable layer-stack arbitration; clients fall back\nto ``1.0`` / a default order if both are absent.\n\n``legend`` is the layer's RESOLVED style, mirrored from ``LayerURI.legend``\n(see ``execution.LegendKey``): the concrete range, the colours and the .qml\nthe map loads. The pipeline emitter copies it onto this summary.",
      "properties": {
        "crs_authid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crs Authid"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "layer_type": {
          "enum": [
            "raster",
            "vector",
            "mesh"
          ],
          "title": "Layer Type",
          "type": "string"
        },
        "legend": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegendKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "opacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opacity"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "reference_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Time"
        },
        "role": {
          "enum": [
            "primary",
            "context",
            "input"
          ],
          "title": "Role",
          "type": "string"
        },
        "temporal": {
          "title": "Temporal",
          "type": "boolean"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "visible": {
          "title": "Visible",
          "type": "boolean"
        },
        "z_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Z Index"
        }
      },
      "required": [
        "layer_id",
        "name",
        "layer_type",
        "uri",
        "visible",
        "role",
        "temporal"
      ],
      "title": "ProjectLayerSummary",
      "type": "object"
    },
