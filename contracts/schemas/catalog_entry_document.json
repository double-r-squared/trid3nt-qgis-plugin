{
  "additionalProperties": false,
  "description": "``catalog_entries``: one curated catalog entry, unwrapped.\nThe collection schema IS the entry schema: no wrapper fields, and no ``_id``\nalias, because one shape across wire, file and store is worth more.",
  "properties": {
    "access_tier": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "Access Tier",
      "type": "integer"
    },
    "api_key_secret_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Key Secret Ref"
    },
    "citation": {
      "minLength": 1,
      "title": "Citation",
      "type": "string"
    },
    "credential_tier": {
      "enum": [
        1,
        2,
        3
      ],
      "title": "Credential Tier",
      "type": "integer"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "how_to_use": {
      "minLength": 1,
      "title": "How To Use",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "last_verified": {
      "format": "date-time",
      "title": "Last Verified",
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "native_resolution_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Resolution M"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_class": {
      "minLength": 1,
      "title": "Source Class",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "user_proposed_pending_curator_review"
      ],
      "title": "Status",
      "type": "string"
    },
    "ttl_class": {
      "enum": [
        "static-30d",
        "semi-static-7d",
        "dynamic-1h",
        "live-no-cache"
      ],
      "title": "Ttl Class",
      "type": "string"
    },
    "urls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Urls",
      "type": "array"
    },
    "vintage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vintage"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "urls",
    "access_tier",
    "credential_tier",
    "ttl_class",
    "source_class",
    "license",
    "citation",
    "last_verified",
    "status",
    "how_to_use"
  ],
  "title": "CatalogEntryDocument",
  "type": "object"
}
