{
  "$defs": {
    "SecretRecord": {
      "additionalProperties": false,
      "description": "One secret reference. The raw key value is NEVER carried here.\nUsage is recorded as ``last_used_at`` and nothing more - no call count, no\nquota, no estimated cost.",
      "properties": {
        "added_at": {
          "format": "date-time",
          "title": "Added At",
          "type": "string"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "is_active": {
          "default": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "last_used_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Used At"
        },
        "provider": {
          "enum": [
            "firms",
            "ecmwf_cds",
            "gtsm",
            "nws",
            "openweathermap",
            "openai",
            "anthropic",
            "google_genai",
            "mapbox",
            "maptiler",
            "generic"
          ],
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "secret_id": {
          "title": "Secret Id",
          "type": "string"
        },
        "vault_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Vault Ref",
          "type": "string"
        }
      },
      "required": [
        "secret_id",
        "provider",
        "vault_ref",
        "added_at"
      ],
      "title": "SecretRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``secrets-list``: server -> client, the secret records.\nA raw key value NEVER appears here - only vault-reference-bearing records.",
  "properties": {
    "envelope_type": {
      "const": "secrets-list",
      "default": "secrets-list",
      "title": "Envelope Type",
      "type": "string"
    },
    "secrets": {
      "items": {
        "$ref": "#/$defs/SecretRecord"
      },
      "title": "Secrets",
      "type": "array"
    }
  },
  "title": "SecretsListEnvelopePayload",
  "type": "object"
}
