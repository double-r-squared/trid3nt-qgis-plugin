{
  "additionalProperties": false,
  "description": "``catalog_audit_log``: the APPEND-ONLY audit trail for the catalog.\nEvery catalog mutation lands one document. It is durable and never\nTTL-cleaned, because a reference recorded on a run must stay resolvable\nback through here to its proposal and review context.",
  "properties": {
    "_id": {
      "title": "Id",
      "type": "string"
    },
    "entry_id": {
      "minLength": 1,
      "title": "Entry Id",
      "type": "string"
    },
    "event_payload": {
      "additionalProperties": true,
      "title": "Event Payload",
      "type": "object"
    },
    "event_type": {
      "enum": [
        "add",
        "update",
        "deprecate",
        "user_proposed",
        "curator_approved",
        "curator_rejected"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "user_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Id"
    }
  },
  "required": [
    "_id",
    "entry_id",
    "event_type",
    "timestamp"
  ],
  "title": "CatalogAuditLogDocument",
  "type": "object"
}
