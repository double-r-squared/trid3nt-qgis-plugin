{
  "$defs": {
    "BaseMetrics": {
      "additionalProperties": false,
      "description": "Empty base; subtype payloads carry the real metric fields.\n\nThe envelope's top-level ``metrics`` field is ``BaseMetrics`` and stays\nempty by design \u2014 real numbers live in the hazard subtype payload\n(``flood.metrics`` etc.), enforcing invariant 3.",
      "properties": {},
      "title": "BaseMetrics",
      "type": "object"
    },
    "CatalogReference": {
      "additionalProperties": false,
      "description": "Denormalized reference to a public_hazard_catalog entry (discovery only).",
      "properties": {
        "access_url": {
          "title": "Access Url",
          "type": "string"
        },
        "agency": {
          "title": "Agency",
          "type": "string"
        },
        "catalog_entry_id": {
          "title": "Catalog Entry Id",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "catalog_entry_id",
        "title",
        "agency",
        "access_url",
        "license"
      ],
      "title": "CatalogReference",
      "type": "object"
    },
    "CriticalFacility": {
      "additionalProperties": false,
      "description": "A flooded critical facility (invariant 1: typed, narratable number).",
      "properties": {
        "category": {
          "enum": [
            "school",
            "hospital",
            "fire_station",
            "police",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        },
        "max_depth_m": {
          "title": "Max Depth M",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "category",
        "coordinates",
        "max_depth_m"
      ],
      "title": "CriticalFacility",
      "type": "object"
    },
    "DataSource": {
      "additionalProperties": false,
      "description": "A single upstream data source, as a typed (not prose) provenance record.",
      "properties": {
        "accessed_at": {
          "format": "date-time",
          "title": "Accessed At",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "accessed_at"
      ],
      "title": "DataSource",
      "type": "object"
    },
    "FallbackActivation": {
      "additionalProperties": false,
      "description": "One rung of a declared fallback ladder that actually served a request.\n\nFields:\n  - ``capability``: the ladder's owner (a tool name or a seam id).\n  - ``rung`` / ``consequence``: which alternative served and what it costs.\n  - ``coverage``: the FRACTION of the request this rung served - 1.0 for a\n    whole-request swap, a partial share for a mosaic that several rungs\n    painted together (0.89 primary + 0.11 cross_dataset).\n  - ``note``: what the alternative IS, in the words the user reads.",
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "consequence": {
          "enum": [
            "primary",
            "user_supplied",
            "enhancement",
            "same_data",
            "cross_dataset",
            "synthetic"
          ],
          "title": "Consequence",
          "type": "string"
        },
        "coverage": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "rung": {
          "title": "Rung",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "rung",
        "consequence"
      ],
      "title": "FallbackActivation",
      "type": "object"
    },
    "FloodMetrics": {
      "additionalProperties": false,
      "description": "Structured flood metrics. Every number the narrative cites lives here.",
      "properties": {
        "affected_buildings_by_depth": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Buildings By Depth"
        },
        "affected_buildings_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Buildings Count"
        },
        "affected_critical_facilities": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CriticalFacility"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Critical Facilities"
        },
        "flooded_area_km2": {
          "minimum": 0.0,
          "title": "Flooded Area Km2",
          "type": "number"
        },
        "grid_resolution_m": {
          "exclusiveMinimum": 0.0,
          "title": "Grid Resolution M",
          "type": "number"
        },
        "max_depth_m": {
          "title": "Max Depth M",
          "type": "number"
        },
        "max_velocity_m_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Velocity M S"
        },
        "mean_depth_m": {
          "title": "Mean Depth M",
          "type": "number"
        },
        "p95_depth_m": {
          "title": "P95 Depth M",
          "type": "number"
        },
        "population_exposed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Exposed"
        },
        "simulation_duration_hours": {
          "exclusiveMinimum": 0,
          "title": "Simulation Duration Hours",
          "type": "integer"
        },
        "solver_version": {
          "title": "Solver Version",
          "type": "string"
        }
      },
      "required": [
        "flooded_area_km2",
        "max_depth_m",
        "mean_depth_m",
        "p95_depth_m",
        "solver_version",
        "grid_resolution_m",
        "simulation_duration_hours"
      ],
      "title": "FloodMetrics",
      "type": "object"
    },
    "FloodPayload": {
      "additionalProperties": false,
      "description": "Flood hazard subtype payload. Populated iff ``hazard_type == 'flood'``.",
      "properties": {
        "metrics": {
          "$ref": "#/$defs/FloodMetrics"
        }
      },
      "required": [
        "metrics"
      ],
      "title": "FloodPayload",
      "type": "object"
    },
    "ForcingSummary": {
      "additionalProperties": false,
      "description": "Boundary-condition summary for a modeled envelope (None for discovery).",
      "properties": {
        "forcing_type": {
          "enum": [
            "storm_surge",
            "pluvial_synthetic",
            "fluvial_synthetic",
            "news_derived",
            "user_supplied"
          ],
          "title": "Forcing Type",
          "type": "string"
        },
        "inputs_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Uri"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "forcing_type",
        "source",
        "parameters"
      ],
      "title": "ForcingSummary",
      "type": "object"
    },
    "LegendKey": {
      "additionalProperties": false,
      "description": "A layer's RESOLVED style: what the reader is looking at, and its scale.\n\nA preset is four renderer shapes parameterised by what the data is; this is\none of them resolved against a particular layer. The colours and the range\nare the SAME ones the render uses, because both come from this one\nresolution - there is no second range to drift.\n\n``qml`` is the resolved preset as QGIS's own style document, which is what\nthe map loads - the ONE record of how the layer is painted, swatches and\nclass breaks included. ``None`` for a layer that is already painted (an\nRGB(A) composite, a COG carrying its own colour table): nothing may\noverride the colours such a file already has.\n\nThe remaining fields are what a reader other than the map asks of a\npublished layer: the scale a packet holds a quantity to, and the words a\nrestyle starts from.\n\n``kind``\n    Which preset shape drew it: ``continuous`` (a ramp over a range),\n    ``classed`` (declared breaks or an embedded class table),\n    ``reference`` (drawn, not measured), ``mesh`` (an MDAL dataset group).\n``colormap``\n    The ramp name, or explicit stops as ``[[stop_0to1, \"#rrggbb\"], ...]``.\n``vmin`` / ``vmax``\n    The one range the layer is read on. ``None`` for a reference layer.\n``units`` / ``label``\n    What the quantity is measured in and what the legend calls it.",
      "properties": {
        "colormap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colormap"
        },
        "kind": {
          "enum": [
            "continuous",
            "classed",
            "reference",
            "mesh"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "qml": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qml"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "vmax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmax"
        },
        "vmin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmin"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LegendKey",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Structured provenance for a modeled or discovered envelope (invariant 7).",
      "properties": {
        "article_ids": {
          "items": {
            "type": "string"
          },
          "title": "Article Ids",
          "type": "array"
        },
        "data_sources": {
          "items": {
            "$ref": "#/$defs/DataSource"
          },
          "title": "Data Sources",
          "type": "array"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ResultLayer": {
      "additionalProperties": false,
      "description": "A renderable result layer.\n\nField-for-field alignable with ``map-command load-layer`` args\n(``layer_id``, ``style``, ``temporal``) so the UI renders without\ntranslation. Output formats are fixed by/: rasters COG,\nvectors FlatGeobuf/GeoParquet. ``LayerURI`` (execution.py) is the producer\nshape that maps onto this.\n\n``style`` mirrors ``LayerURI.style`` (the declared row) and ``legend``\nmirrors ``LayerURI.legend`` (that row resolved against this layer, with the\nconcrete range and the .qml the map loads).",
      "properties": {
        "fallback_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Note"
        },
        "fallbacks": {
          "items": {
            "$ref": "#/$defs/FallbackActivation"
          },
          "title": "Fallbacks",
          "type": "array"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "layer_type": {
          "enum": [
            "raster",
            "vector"
          ],
          "title": "Layer Type",
          "type": "string"
        },
        "legend": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegendKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "context",
            "input"
          ],
          "title": "Role",
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        },
        "temporal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "layer_id",
        "name",
        "layer_type",
        "uri",
        "role"
      ],
      "title": "ResultLayer",
      "type": "object"
    },
    "TemporalConfig": {
      "additionalProperties": false,
      "description": "WMS-T temporal config for a time-varying layer.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "step_seconds": {
          "exclusiveMinimum": 0,
          "title": "Step Seconds",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "step_seconds"
      ],
      "title": "TemporalConfig",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "description": "A UTC start/end interval. Shared by AssessmentEnvelope and EventMetadata.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The central output structure.\n\n    For a given envelope, exactly one subtype field matching ``hazard_type`` is\n    populated; the rest are ``None``. ``envelope_type`` (modeled vs discovered)\n    is independent of ``hazard_type``.\n\n    v0.1 note: only the flood subtype is fully typed (``FloodPayload``). The\n    v0.2+/v0.3+ subtypes (groundwater/wildfire/seismic/spill) are carried as\n    permissive ``dict | None`` slots until their engines land \u2014 matching\n.6b, which states discovery payloads are a permissive dict\n    validated at the workflow layer in v0.1. See report Open Question OQ-S2.\n    ",
  "properties": {
    "bbox": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Bbox",
      "type": "array"
    },
    "catalog_entries": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CatalogReference"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Entries"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "crs": {
      "default": "EPSG:4326",
      "title": "Crs",
      "type": "string"
    },
    "envelope_id": {
      "title": "Envelope Id",
      "type": "string"
    },
    "envelope_type": {
      "enum": [
        "modeled",
        "discovered"
      ],
      "title": "Envelope Type",
      "type": "string"
    },
    "flood": {
      "anyOf": [
        {
          "$ref": "#/$defs/FloodPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "forcing": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForcingSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "groundwater": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Groundwater"
    },
    "hazard_type": {
      "enum": [
        "flood",
        "groundwater",
        "wildfire",
        "seismic",
        "spill"
      ],
      "title": "Hazard Type",
      "type": "string"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/ResultLayer"
      },
      "title": "Layers",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/BaseMetrics"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seismic": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seismic"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "solver_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Solver Run Ids",
      "type": "array"
    },
    "spill": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spill"
    },
    "time_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "wildfire": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wildfire"
    },
    "workflow_name": {
      "title": "Workflow Name",
      "type": "string"
    }
  },
  "required": [
    "envelope_id",
    "project_id",
    "session_id",
    "envelope_type",
    "hazard_type",
    "workflow_name",
    "bbox",
    "provenance",
    "created_at",
    "completed_at"
  ],
  "title": "AssessmentEnvelope",
  "type": "object"
}
