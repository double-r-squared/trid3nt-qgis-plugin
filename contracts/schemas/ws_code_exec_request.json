{
  "additionalProperties": false,
  "description": "``code-exec-request``, emitted BEFORE a code request reaches the session.\nApproval returns on a payload-confirmation whose ``warning_id`` equals\n``code_exec_id``; anything but ``proceed`` fails closed.",
  "properties": {
    "code_exec_id": {
      "title": "Code Exec Id",
      "type": "string"
    },
    "envelope_type": {
      "const": "code-exec-request",
      "default": "code-exec-request",
      "title": "Envelope Type",
      "type": "string"
    },
    "python_code": {
      "maxLength": 65536,
      "minLength": 1,
      "title": "Python Code",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    }
  },
  "required": [
    "code_exec_id",
    "python_code"
  ],
  "title": "CodeExecRequestPayload",
  "type": "object"
}
