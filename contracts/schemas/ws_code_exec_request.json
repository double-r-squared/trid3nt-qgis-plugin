{
  "additionalProperties": false,
  "description": "``code-exec-request``, emitted BEFORE the sandbox runs.\nThe client renders a confirm card and the user approves or denies on a\npayload-confirmation whose ``warning_id`` equals ``code_exec_id``. No cost\nor quota field: the consequential act is running code, not a billed run.",
  "properties": {
    "code_exec_id": {
      "title": "Code Exec Id",
      "type": "string"
    },
    "envelope_type": {
      "const": "code-exec-request",
      "default": "code-exec-request",
      "title": "Envelope Type",
      "type": "string"
    },
    "layer_refs": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "title": "Layer Refs",
      "type": "object"
    },
    "python_code": {
      "maxLength": 65536,
      "minLength": 1,
      "title": "Python Code",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    }
  },
  "required": [
    "code_exec_id",
    "python_code"
  ],
  "title": "CodeExecRequestPayload",
  "type": "object"
}
