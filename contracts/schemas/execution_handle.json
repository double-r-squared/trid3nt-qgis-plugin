    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "workflow_location": {
      "title": "Workflow Location",
      "type": "string"
    },
    "workflow_name": {
      "title": "Workflow Name",
      "type": "string"
    },
    "workflows_execution_id": {
      "title": "Workflows Execution Id",
