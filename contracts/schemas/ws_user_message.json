{
  "$defs": {
    "DrawnGeometry": {
      "additionalProperties": false,
      "description": "A user-drawn geometry attached to a ``user-message``.\nA per-turn STRUCTURED spatial knob, distinct from the analysis AOI, which an\ninput-review gate consumes as user-supplied. The ``geometry_type``\ndiscriminator leaves room for a polygon editor; only a rectangle is wired.",
      "properties": {
        "bbox": {
          "items": {
            "type": "number"
          },
          "title": "Bbox",
          "type": "array"
        },
        "geometry_type": {
          "const": "rectangle",
          "default": "rectangle",
          "title": "Geometry Type",
          "type": "string"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "DrawnGeometry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``user-message``: one user-submitted turn.",
  "properties": {
    "aoi_bbox": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aoi Bbox"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "drawn_geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/DrawnGeometry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "show_thinking": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Show Thinking"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "tool_choice_mode": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "ask"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Choice Mode"
    }
  },
  "required": [
    "text"
  ],
  "title": "UserMessagePayload",
  "type": "object"
}
