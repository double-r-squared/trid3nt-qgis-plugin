      "default": null,
      "title": "Caption"
    },
    "chart_id": {
      "title": "Chart Id",
      "type": "string"
    },
    "created_turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
