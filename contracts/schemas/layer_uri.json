{
  "$defs": {
    "FallbackActivation": {
      "additionalProperties": false,
      "description": "One rung of a declared fallback ladder that actually served a request.",
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "consequence": {
          "enum": [
            "primary",
            "user_supplied",
            "enhancement",
            "same_data",
            "cross_dataset",
            "synthetic"
          ],
          "title": "Consequence",
          "type": "string"
        },
        "coverage": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "rung": {
          "title": "Rung",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "rung",
        "consequence"
      ],
      "title": "FallbackActivation",
      "type": "object"
    },
    "LegendKey": {
      "additionalProperties": false,
      "description": "A layer's RESOLVED style: what the reader is looking at, and its scale.\nThe colours and the range here are the SAME ones the render uses, because\nboth come from this one resolution - there is no second range to drift.",
      "properties": {
        "colormap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colormap"
        },
        "kind": {
          "enum": [
            "continuous",
            "classed",
            "reference",
            "mesh"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "qml": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qml"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "vmax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmax"
        },
        "vmin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmin"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LegendKey",
      "type": "object"
    },
    "SyntheticInput": {
      "additionalProperties": false,
      "description": "One structured provenance entry for a physical model input.\nADDITIVE and default-empty: an empty list means \"no declared provenance\",\nNEVER \"all real\".",
      "properties": {
        "basis": {
          "enum": [
            "fetched",
            "user",
            "prompt_interpreted",
            "default_demo",
            "derived",
            "measured_inversion",
            "scenario_slab2"
          ],
          "title": "Basis",
          "type": "string"
        },
        "consequence": {
          "anyOf": [
            {
              "enum": [
                "physics",
                "scenario",
                "numerical",
                "aoi"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consequence"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "param": {
          "title": "Param",
          "type": "string"
        },
        "real_source_if_any": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Real Source If Any"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "param",
        "basis"
      ],
      "title": "SyntheticInput",
      "type": "object"
    },
    "TemporalConfig": {
      "additionalProperties": false,
      "description": "WMS-T temporal config for a time-varying layer.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "step_seconds": {
          "exclusiveMinimum": 0,
          "title": "Step Seconds",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "step_seconds"
      ],
      "title": "TemporalConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "ONE produced output layer, aligned field-for-field with the\n``load-layer`` map command so it reaches the map untranslated. The producer\nDECLARES a style; the publish path RESOLVES it into ``legend``.",
  "properties": {
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "crs_authid": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Crs Authid"
    },
    "dataset_uris": {
      "items": {
        "type": "string"
      },
      "title": "Dataset Uris",
      "type": "array"
    },
    "fallback_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Note"
    },
    "fallbacks": {
      "items": {
        "$ref": "#/$defs/FallbackActivation"
      },
      "title": "Fallbacks",
      "type": "array"
    },
    "layer_id": {
      "title": "Layer Id",
      "type": "string"
    },
    "layer_type": {
      "enum": [
        "raster",
        "vector",
        "mesh"
      ],
      "title": "Layer Type",
      "type": "string"
    },
    "legend": {
      "anyOf": [
        {
          "$ref": "#/$defs/LegendKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "origin": {
      "anyOf": [
        {
          "const": "user",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin"
    },
    "quantity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity"
    },
    "reference_time": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Time"
    },
    "role": {
      "default": "primary",
      "enum": [
        "primary",
        "context",
        "input"
      ],
      "title": "Role",
      "type": "string"
    },
    "style": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Style"
    },
    "synthetic_inputs": {
      "items": {
        "$ref": "#/$defs/SyntheticInput"
      },
      "title": "Synthetic Inputs",
      "type": "array"
    },
    "temporal": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemporalConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "units": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Units"
    },
    "uri": {
      "title": "Uri",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    }
  },
  "required": [
    "layer_id",
    "name",
    "layer_type",
    "uri"
  ],
  "title": "LayerURI",
  "type": "object"
}
