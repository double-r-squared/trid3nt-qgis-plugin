{
  "additionalProperties": false,
  "description": "``credential-request``: server -> client, a key is needed NOW.\nThe tool pauses and the answer takes the existing ``secret-add`` path, so\nthis envelope carries NO key material in either direction.",
  "properties": {
    "envelope_type": {
      "const": "credential-request",
      "default": "credential-request",
      "title": "Envelope Type",
      "type": "string"
    },
    "message": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "provider_id": {
      "enum": [
        "firms",
        "ecmwf_cds",
        "gtsm",
        "nws",
        "openweathermap",
        "openai",
        "anthropic",
        "google_genai",
        "mapbox",
        "maptiler",
        "generic"
      ],
      "title": "Provider Id",
      "type": "string"
    },
    "provider_label": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Provider Label",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "secret_key_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Secret Key Name",
      "type": "string"
    },
    "signup_url": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signup Url"
    },
    "tool_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "provider_id",
    "provider_label",
    "secret_key_name",
    "message",
    "tool_name"
  ],
  "title": "CredentialRequestEnvelopePayload",
  "type": "object"
}
