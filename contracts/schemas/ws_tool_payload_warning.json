{
  "$defs": {
    "GranularitySuggestion": {
      "additionalProperties": false,
      "description": "A pre-run GRANULARITY suggestion, optional on a payload warning.\nIt makes resolution a USER LEVER rather than a silent auto-coarsen, showing\nthe cost of resolution before the run. No number here is a price.",
      "properties": {
        "cell_cap": {
          "exclusiveMinimum": 0,
          "title": "Cell Cap",
          "type": "integer"
        },
        "coarsened": {
          "title": "Coarsened",
          "type": "boolean"
        },
        "compute_class": {
          "minLength": 1,
          "title": "Compute Class",
          "type": "string"
        },
        "engine": {
          "enum": [
            "swmm",
            "sfincs",
            "dem",
            "topobathy",
            "landcover",
            "telemac"
          ],
          "title": "Engine",
          "type": "string"
        },
        "estimated_active_cells": {
          "minimum": 0,
          "title": "Estimated Active Cells",
          "type": "integer"
        },
        "estimated_solve_seconds": {
          "minimum": 0.0,
          "title": "Estimated Solve Seconds",
          "type": "number"
        },
        "reason": {
          "maxLength": 512,
          "title": "Reason",
          "type": "string"
        },
        "resolution_choices": {
          "items": {
            "type": "number"
          },
          "title": "Resolution Choices",
          "type": "array"
        },
        "resolution_param": {
          "enum": [
            "target_resolution_m",
            "grid_resolution_m",
            "resolution_m",
            "mesh_resolution_m"
          ],
          "title": "Resolution Param",
          "type": "string"
        },
        "spot_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spot Label"
        },
        "suggested_resolution_m": {
          "exclusiveMinimum": 0.0,
          "title": "Suggested Resolution M",
          "type": "number"
        },
        "vcpus": {
          "exclusiveMinimum": 0,
          "title": "Vcpus",
          "type": "integer"
        }
      },
      "required": [
        "engine",
        "resolution_param",
        "suggested_resolution_m",
        "estimated_active_cells",
        "estimated_solve_seconds",
        "vcpus",
        "compute_class",
        "cell_cap",
        "coarsened",
        "reason"
      ],
      "title": "GranularitySuggestion",
      "type": "object"
    },
    "ParamSheet": {
      "additionalProperties": false,
      "description": "The resolved sheet a step reviewing its own inputs presents.\nRows arrive in RENDER order, owned by whoever owns the doors. A\nsubmit-with-edits IS the approval - the whole sheet was visible.",
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/ParamSheetRow"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "title": {
          "default": "",
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        },
        "workflow": {
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "workflow",
        "rows"
      ],
      "title": "ParamSheet",
      "type": "object"
    },
    "ParamSheetRow": {
      "additionalProperties": false,
      "description": "One row of the resolved param sheet a form card renders.\nRicher than a provenance line: an EDIT SURFACE needs the declaration too -\nwhat the value means, what it may become, and how loudly to warn.",
      "properties": {
        "advanced": {
          "default": false,
          "title": "Advanced",
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "fetched",
            "user",
            "prompt_interpreted",
            "default_demo",
            "derived",
            "measured_inversion",
            "scenario_slab2"
          ],
          "title": "Basis",
          "type": "string"
        },
        "bounds": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bounds"
        },
        "desc": {
          "default": "",
          "maxLength": 512,
          "title": "Desc",
          "type": "string"
        },
        "door": {
          "enum": [
            "user",
            "question",
            "derived",
            "scenario",
            "constant",
            "gate"
          ],
          "title": "Door",
          "type": "string"
        },
        "editable": {
          "default": true,
          "title": "Editable",
          "type": "boolean"
        },
        "group": {
          "default": "",
          "maxLength": 120,
          "title": "Group",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "template",
                "user",
                "model",
                "producer",
                "derived",
                "calibrated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "source_badge": {
          "default": "",
          "maxLength": 200,
          "title": "Source Badge",
          "type": "string"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "user_lever": {
          "default": false,
          "title": "User Lever",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "door",
        "basis"
      ],
      "title": "ParamSheetRow",
      "type": "object"
    },
    "SyntheticInput": {
      "additionalProperties": false,
      "description": "One structured provenance entry for a physical model input.\nADDITIVE and default-empty: an empty list means \"no declared provenance\",\nNEVER \"all real\".",
      "properties": {
        "basis": {
          "enum": [
            "fetched",
            "user",
            "prompt_interpreted",
            "default_demo",
            "derived",
            "measured_inversion",
            "scenario_slab2"
          ],
          "title": "Basis",
          "type": "string"
        },
        "consequence": {
          "anyOf": [
            {
              "enum": [
                "physics",
                "scenario",
                "numerical",
                "aoi"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consequence"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "param": {
          "title": "Param",
          "type": "string"
        },
        "real_source_if_any": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Real Source If Any"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "param",
        "basis"
      ],
      "title": "SyntheticInput",
      "type": "object"
    },
    "TimeScaleSuggestion": {
      "additionalProperties": false,
      "description": "A pre-run TIME-SCALE suggestion, optional on a payload warning.\nCadence and window together fix the FRAME COUNT: too many balloon the\npayload, too few hide the motion. Absent when the cadence is fixed.",
      "properties": {
        "cadence_param": {
          "const": "output_interval_min",
          "default": "output_interval_min",
          "title": "Cadence Param",
          "type": "string"
        },
        "duration_param": {
          "const": "duration_hr",
          "default": "duration_hr",
          "title": "Duration Param",
          "type": "string"
        },
        "estimated_frame_count": {
          "minimum": 1,
          "title": "Estimated Frame Count",
          "type": "integer"
        },
        "interval_choices": {
          "items": {
            "type": "number"
          },
          "title": "Interval Choices",
          "type": "array"
        },
        "is_coastal": {
          "default": true,
          "title": "Is Coastal",
          "type": "boolean"
        },
        "max_frames": {
          "exclusiveMinimum": 0,
          "title": "Max Frames",
          "type": "integer"
        },
        "min_interval_min": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Min Interval Min",
          "type": "number"
        },
        "reason": {
          "default": "",
          "maxLength": 512,
          "title": "Reason",
          "type": "string"
        },
        "suggested_duration_hr": {
          "exclusiveMinimum": 0.0,
          "title": "Suggested Duration Hr",
          "type": "number"
        },
        "suggested_interval_min": {
          "exclusiveMinimum": 0.0,
          "title": "Suggested Interval Min",
          "type": "number"
        }
      },
      "required": [
        "suggested_interval_min",
        "suggested_duration_hr",
        "estimated_frame_count",
        "max_frames"
      ],
      "title": "TimeScaleSuggestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``tool-payload-warning``: the gate a heavy dispatch pauses on.\nBoth numbers travel - the estimate AND the threshold it crossed - so why the\ngate fired is visible rather than narrated. No number here is a price.",
  "properties": {
    "alternative_args": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alternative Args"
    },
    "envelope_type": {
      "const": "tool-payload-warning",
      "default": "tool-payload-warning",
      "title": "Envelope Type",
      "type": "string"
    },
    "estimated_mb": {
      "minimum": 0.0,
      "title": "Estimated Mb",
      "type": "number"
    },
    "granularity": {
      "anyOf": [
        {
          "$ref": "#/$defs/GranularitySuggestion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "options": {
      "items": {
        "enum": [
          "proceed",
          "cancel",
          "narrow_scope"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Options",
      "type": "array"
    },
    "param_sheet": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParamSheet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recommendation": {
      "maxLength": 512,
      "title": "Recommendation",
      "type": "string"
    },
    "synthetic_inputs": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SyntheticInput"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Synthetic Inputs"
    },
    "threshold_mb": {
      "minimum": 0.0,
      "title": "Threshold Mb",
      "type": "number"
    },
    "time_scale": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeScaleSuggestion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_args": {
      "additionalProperties": true,
      "title": "Tool Args",
      "type": "object"
    },
    "tool_name": {
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    },
    "ttl_seconds": {
      "default": 300,
      "minimum": 1,
      "title": "Ttl Seconds",
      "type": "integer"
    },
    "warning_id": {
      "title": "Warning Id",
      "type": "string"
    }
  },
  "required": [
    "warning_id",
    "tool_name",
    "estimated_mb",
    "threshold_mb",
    "recommendation"
  ],
  "title": "PayloadWarningEnvelopePayload",
  "type": "object"
}
