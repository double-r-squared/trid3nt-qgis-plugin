{
  "$defs": {
    "PipelineStep": {
      "additionalProperties": false,
      "description": "One step in the pipeline snapshot.\nEvery number here is deterministic - measured or mirrored from a control\nplane - and never a model's estimate.",
      "properties": {
        "batch_job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Job Id"
        },
        "batch_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Status"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Step Id"
        },
        "progress_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress Percent"
        },
        "role": {
          "default": "tool",
          "enum": [
            "tool",
            "compute"
          ],
          "title": "Role",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "state": {
          "enum": [
            "pending",
            "running",
            "complete",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "substep_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substep Index"
        },
        "substep_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substep Label"
        },
        "substep_total": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substep Total"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "name",
        "tool_name",
        "state"
      ],
      "title": "PipelineStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``pipeline-state``: the FULL snapshot of the current pipeline.\nIt REPLACES a client's pipeline view outright; there are no deltas to\nreconcile.",
  "properties": {
    "pipeline_id": {
      "title": "Pipeline Id",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PipelineStep"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "pipeline_id"
  ],
  "title": "PipelineStatePayload",
  "type": "object"
}
