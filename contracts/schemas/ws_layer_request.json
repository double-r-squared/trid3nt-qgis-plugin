{
  "additionalProperties": false,
  "description": "``layer-request``: one provider layer for the session to open, agent ->\nclient. The uri is the provider's OWN datasource string, already templated\nover the bbox and the row's ask; the session passes it through verbatim.",
  "properties": {
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "credential": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential"
    },
    "key": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "mode": {
      "enum": [
        "open",
        "materialise"
      ],
      "title": "Mode",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "resolution_m": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution M"
    },
    "uri": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "key",
    "provider",
    "uri",
    "name",
    "mode"
  ],
  "title": "LayerRequestPayload",
  "type": "object"
}
